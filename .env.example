# MongoDB Atlas connection string
MONGODB_URI=YOUR_MONGODB_URI

# Secret used by lib/auth.ts for DB-backed session token hashing/signing (see PLAN-GROOMA.md §1)
SESSION_SECRET=YOUR_SESSION_SECRET

# How this deployment's HOST collects QRIS payments (PRD §9.6). One deployment
# serves exactly one HOST (§3.5), so this is a deployment-level setting.
#   MANAGED       = QRIS is generated through this HOST's own Midtrans account
#                   (credentials below). Requires MIDTRANS_* to be set.
#   SELF_RECORDED = the HOST collects on its own QRIS outside Grooma; Grooma
#                   only records the transaction. Leave MIDTRANS_* empty.
# Unset defaults to MANAGED. Boot fails fast if MANAGED without credentials.
PAYMENT_INTEGRATION_MODE=MANAGED

# Midtrans credentials — https://dashboard.midtrans.com (server-side only, never
# exposed to frontend). These belong to THIS deployment's HOST, not to Grooma:
# settlement goes straight to that HOST's own Midtrans balance and bank account.
# Required when PAYMENT_INTEGRATION_MODE=MANAGED; omit entirely for SELF_RECORDED.
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=YOUR_MIDTRANS_IS_PRODUCTION

# Grooma's OWN Midtrans account — separate from the HOST's account above
# (PRD §23.1/§23.8). Subscription invoices (what this HOST pays Grooma)
# always charge through this account, never the HOST's own MIDTRANS_*
# credentials, regardless of PAYMENT_INTEGRATION_MODE. Same value across
# every deployment in the fleet (one Grooma merchant account), unlike
# MIDTRANS_* above which is unique per HOST. REQUIRED on every deployment,
# including SELF_RECORDED ones — boot fails fast if either key is missing.
GROOMA_BILLING_MIDTRANS_SERVER_KEY=YOUR_GROOMA_BILLING_MIDTRANS_SERVER_KEY
GROOMA_BILLING_MIDTRANS_CLIENT_KEY=YOUR_GROOMA_BILLING_MIDTRANS_CLIENT_KEY
GROOMA_BILLING_MIDTRANS_IS_PRODUCTION=YOUR_GROOMA_BILLING_MIDTRANS_IS_PRODUCTION

# Public base URL of THIS deployment, used as the server entry in the Scalar
# API docs (app/scalar/docs/_config.ts). Optional: on Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL, and to localhost otherwise.
APP_BASE_URL=

# Must be set explicitly to "production" in production deployments — unlike
# NODE_ENV, this is not auto-set by Next.js per command. Gates the session
# cookie's `secure` flag (lib/auth.ts) and hiding /scalar/docs (app/scalar/docs/route.ts).
APPLICATION_ENVIRONMENT=YOUR_APPLICATION_ENVIRONMENT

# Shared secret for POST /api/v1/internal/subscriptions/run-billing-cycle (scheduled job auth, not a user session)
INTERNAL_CRON_SECRET=YOUR_INTERNAL_CRON_SECRET

# Number of proxies in front of this deployment that append to X-Forwarded-For.
# REQUIRED when APPLICATION_ENVIRONMENT=production — the login rate limit cannot
# distinguish a real client address from a spoofed header without it, and there
# is no safe value to infer (PRD §2 allows Vercel or self-hosted Node).
#   0 = app reached directly, no proxy (correct for local `next dev`)
#   1 = exactly one trusted proxy/CDN in front (typical managed platform)
#   n = n trusted hops
TRUSTED_PROXY_HOP_COUNT=0

# Set to "true" to reject POST /api/v1/transactions without an Idempotency-Key
# header. Leave unset/false until the mobile build pointed at this deployment
# sends the header; unkeyed submits are logged in the meantime so adoption can
# be confirmed before enforcing.
REQUIRE_IDEMPOTENCY_KEY=false
