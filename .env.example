# MongoDB Atlas connection string
MONGODB_URI=YOUR_MONGODB_URI

# Secret used by lib/auth.ts for DB-backed session token hashing/signing (see PLAN-GROOMA.md §1)
SESSION_SECRET=YOUR_SESSION_SECRET

# Midtrans sandbox credentials — https://dashboard.midtrans.com (server-side only, never exposed to frontend)
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_MIDTRANS_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=YOUR_MIDTRANS_IS_PRODUCTION

# Next.js sets this automatically per command (next dev -> development, next build/start -> production);
# listed here for non-Next tooling that reads process.env.NODE_ENV directly.
NODE_ENV=YOUR_NODE_ENV

# Shared secret for POST /api/v1/internal/subscriptions/run-billing-cycle (scheduled job auth, not a user session)
INTERNAL_CRON_SECRET=YOUR_INTERNAL_CRON_SECRET
